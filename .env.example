# Or7 Table — variáveis do frontend (Vite)
# Copie para .env.local e preencha. Nunca coloque a chave service_role aqui:
# tudo que começa com VITE_ vai para o navegador.

# Supabase → Project Settings → API Keys
# Use a Publishable key (sb_publishable_...) — a anon legada também funciona.
# NUNCA coloque aqui a Secret key nem a service_role.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-publishable-key

# Endereço público onde o Or7 Table será publicado (sem barra no final).
# É a base dos QR Codes: {VITE_PUBLIC_SITE_URL}/table/{slug}
# Se ficar vazio, o sistema usa o endereço atual do navegador.
VITE_PUBLIC_SITE_URL=

# Contato comercial usado nos botões "Solicitar demonstração".
# WhatsApp só com números, com DDI e DDD (ex.: 5511999999999).
VITE_CONTACT_WHATSAPP=
VITE_CONTACT_EMAIL=
